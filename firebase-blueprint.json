{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "VibeGram creator profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z0-9._]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bio": { "type": "string", "maxLength": 240 },
        "location": { "type": "string", "maxLength": 80 },
        "avatarUrl": { "type": "string", "maxLength": 350000 },
        "auraBadge": { "type": "string", "maxLength": 40 },
        "auraBorder": { "type": "string", "enum": ["sunset", "flame", "magenta", "violet", "aurora", "cyan", "emerald"] },
        "voiceBioUrl": { "type": "string", "maxLength": 2000 },
        "voiceBioTranscript": { "type": "string", "maxLength": 240 },
        "voiceBioDuration": { "type": "number" },
        "voiceBioWaveform": { "type": "array" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "sparksCount": { "type": "number" },
        "isDiscoverable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "handle",
        "displayName",
        "bio",
        "location",
        "avatarUrl",
        "auraBadge",
        "auraBorder",
        "voiceBioUrl",
        "voiceBioTranscript",
        "voiceBioDuration",
        "voiceBioWaveform",
        "followersCount",
        "followingCount",
        "sparksCount",
        "isDiscoverable",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user settings and PII isolated under owner-only subcollection.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "innerCircleIds": { "type": "array" },
        "bookmarkedPostIds": { "type": "array" },
        "likedPostIds": { "type": "array" },
        "followingIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "innerCircleIds", "bookmarkedPostIds", "likedPostIds", "followingIds", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Real user feed post or Spark video uploaded via Cloudinary/Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorHandle": { "type": "string", "minLength": 2, "maxLength": 32 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 350000 },
        "authorAura": { "type": "string", "maxLength": 40 },
        "mediaUrl": { "type": "string", "minLength": 1, "maxLength": 450000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 80 },
        "mood": { "type": "string", "enum": ["Desi", "Music", "Chill", "Gaming", "Tech", "Aesthetic"] },
        "visibility": { "type": "string", "enum": ["public", "inner_circle"] },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "views": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "authorId",
        "authorHandle",
        "authorName",
        "authorAvatar",
        "authorAura",
        "mediaUrl",
        "mediaType",
        "caption",
        "location",
        "mood",
        "visibility",
        "likesCount",
        "commentsCount",
        "views",
        "createdAt",
        "updatedAt"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "Text or 10-second voice note comment attached to a post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorHandle": { "type": "string", "minLength": 2, "maxLength": 32 },
        "authorAvatar": { "type": "string", "maxLength": 350000 },
        "type": { "type": "string", "enum": ["text", "voice"] },
        "text": { "type": "string", "maxLength": 300 },
        "audioUrl": { "type": "string", "maxLength": 2000 },
        "audioDuration": { "type": "number" },
        "waveform": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorHandle", "authorAvatar", "type", "text", "audioUrl", "audioDuration", "waveform", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Real vertical capsule story uploaded via Your Capsule or Create.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorHandle": { "type": "string", "minLength": 2, "maxLength": 32 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 350000 },
        "authorAura": { "type": "string", "maxLength": 40 },
        "mediaUrl": { "type": "string", "minLength": 1, "maxLength": 450000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string", "maxLength": 200 },
        "mood": { "type": "string", "enum": ["Desi", "Music", "Chill", "Gaming", "Tech", "Aesthetic"] },
        "visibility": { "type": "string", "enum": ["public", "inner_circle"] },
        "viewedBy": { "type": "array" },
        "likedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorHandle", "authorName", "authorAvatar", "authorAura", "mediaUrl", "mediaType", "caption", "mood", "visibility", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Activity notification for likes, comments, and new followers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "senderHandle": { "type": "string", "minLength": 2, "maxLength": 32 },
        "senderAvatar": { "type": "string", "maxLength": 350000 },
        "type": { "type": "string", "enum": ["like", "comment", "follow"] },
        "postId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientId", "senderId", "senderName", "senderHandle", "senderAvatar", "type", "postId", "read", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "1-on-1 direct message thread between two real users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "lastMessage", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a 1-on-1 chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reaction": { "type": "string", "maxLength": 8 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "chatId", "senderId", "participantIds", "text", "reaction", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Real creator profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only private settings and PII."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Real user feed posts and Sparks videos."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Text and voice-note comments on a post."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Real user vertical capsule stories."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time user activity notifications."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Direct message thread metadata."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Direct messages inside a chat thread."
    }
  }
}
